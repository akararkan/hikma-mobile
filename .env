# Copy to `.env` and edit. Expo SDK 57 inlines EXPO_PUBLIC_* at build time,
# which is the direct equivalent of the web app's VITE_* vars.
# These values ship inside the bundle — nothing secret goes here.
# Read by src/platform/env.js.

# Backend origin. MUST be absolute: a native app has no page origin to be
# relative to, so there is no dev-proxy mode the way the web app had.
# `localhost` is rewritten to 10.0.2.2 on Android emulators automatically
# (src/platform/env.js) — a physical device needs the machine's LAN IP here.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.122:8080

# Mock mode — the whole app off src/mock/data.json, no backend at all.
# A device-local override wins over this: storage.setItem('ika_mock','on'|'off').
EXPO_PUBLIC_USE_MOCK=false
EXPO_PUBLIC_MOCK_LANG=en
EXPO_PUBLIC_MOCK_DELAY_MS=220

EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_BUILD=

# WebRTC ICE servers for calls/live (step 7). JSON array of RTCIceServer
# objects; empty falls back to STUN-only defaults.
EXPO_PUBLIC_ICE_SERVERS=

# Universal Links / App Links (LINKS.md). Comma-separated BARE HOSTS the app
# should claim https links on — the short-link host and the web app's host,
# e.g. "share.hikmah.app,hikmah.app". Read at prebuild by app.config.js;
# empty (the default) adds nothing. Requires the domain to host the
# .well-known association files — see LINKS.md — and a native rebuild.
EXPO_PUBLIC_LINK_DOMAINS=
