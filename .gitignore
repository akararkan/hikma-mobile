# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Push credentials. google-services.json only carries public project ids, but
# it names YOUR Firebase project — and the service-account key beside it is a
# private key that can send push as you. Neither belongs in a repo that might
# ever go public. See PUSH.md.
google-services.json
GoogleService-Info.plist
*service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Markdown docs — kept locally, not shipped to the repo
*.md

# editor / agent dirs
.vscode/
.idea/
.claude/

# archives
*.zip

# native module gradle output
modules/**/build/
